# ==========================================
# MORENINHA DO BRONZE - CONFIGURAÇÃO DE SEGURANÇA
# ==========================================

# GEMINI_API_KEY: Chave da API protegida no servidor (opcional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL do aplicativo (Vercel ou servidor próprio)
APP_URL="https://seu-app.vercel.app"

# ==========================================
# CREDENCIAIS DA ADMINISTRADORA (PROTEÇÃO NO SERVIDOR)
# Nenhuma senha fica fixa no código fonte!
# ==========================================
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="SuaSenhaSeguraAqui123!"

# Chave secreta para criptografia de tokens e sessões seguras
ADMIN_SESSION_SECRET="sua_chave_secreta_super_segura_vip_studio_2026"

# Ambiente de execução: production desativa debugs e oculta detalhes de erros
NODE_ENV="production"
